# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, never expose to the client or commit it.
# Used for admin actions (creating teacher auth accounts) and the Excel importer.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
